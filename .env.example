# Neon connection string (pooled). Vercel adds it automatically when you connect Neon.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-string
